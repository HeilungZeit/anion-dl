{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "player",
  "description": "Окно с одной серией. Набор урезан осознанно: плееру нечего делать с диалогами выбора папки, апдейтером, перезапуском приложения и сайдкаром ffmpeg — всё это остаётся у окна main, которое владеет очередью загрузок.",
  "windows": [
    "player-*"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-is-fullscreen",
    "core:window:allow-set-fullscreen",
    "core:window:allow-set-focus",
    "core:window:allow-close",
    "core:window:allow-destroy",
    "core:window:allow-set-title",
    "store:default",
    {
      "identifier": "http:default",
      "allow": [
        {
          "url": "https://anion.online/*"
        }
      ]
    }
  ]
}
